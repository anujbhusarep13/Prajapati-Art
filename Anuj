<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Prajapati Art | Handmade Murtis</title>

    <meta name="description"
        content="Prajapati Art - Handmade Ganesh and Durga murtis made with traditional artistic designs.">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #fff8ed;
            color: #333;
            line-height: 1.6;
        }

        /* HEADER */
        header {
            background: linear-gradient(135deg, #8b2f00, #d65a00);
            color: white;
            text-align: center;
            padding: 55px 20px;
        }

        header h1 {
            font-size: 45px;
            margin-bottom: 10px;
        }

        header p {
            font-size: 20px;
        }

        /* NAVIGATION */
        nav {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: #5c1f00;
            padding: 14px 10px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            margin: 0 12px;
        }

        nav a:hover {
            color: #ffd27f;
        }

        /* SECTIONS */
        section {
            padding: 55px 20px;
            text-align: center;
        }

        section h2 {
            color: #8b2f00;
            font-size: 32px;
            margin-bottom: 15px;
        }

        .intro {
            max-width: 750px;
            margin: auto;
        }

        /* BUTTON */
        .button {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 25px;
            background: #8b2f00;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
        }

        .button:hover {
            background: #c44b00;
        }

        /* PRODUCTS */
        .products {
            max-width: 1100px;
            margin: 30px auto 0;
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .card {
            width: 300px;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            transition: transform 0.3s;
        }

        .card:hover {
            transform: translateY(-6px);
        }

        .product-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
            display: block;
        }

        .card-content {
            padding: 20px;
        }

        .card h3 {
            color: #8b2f00;
            font-size: 23px;
            margin-bottom: 8px;
        }

        /* GALLERY */
        .gallery {
            max-width: 1100px;
            margin: 30px auto;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .gallery img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 12px;
            transition: transform 0.3s;
        }

        .gallery img:hover {
            transform: scale(1.03);
        }

        /* ABOUT */
        .about-box {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        /* CONTACT */
        .contact-box {
            max-width: 600px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        .contact-box p {
            margin: 10px 0;
            font-size: 18px;
        }

        .contact-box a {
            color: #8b2f00;
            font-weight: bold;
            text-decoration: none;
        }

        /* FOOTER */
        footer {
            background: #5c1f00;
            color: white;
            text-align: center;
            padding: 25px 15px;
        }

        /* MOBILE */
        @media (max-width: 700px) {

            header h1 {
                font-size: 34px;
            }

            header p {
                font-size: 17px;
            }

            nav a {
                display: inline-block;
                margin: 5px 7px;
                font-size: 14px;
            }

            .gallery {
                grid-template-columns: 1fr 1fr;
            }

            .gallery img {
                height: 180px;
            }
        }

        @media (max-width: 450px) {

            .gallery {
                grid-template-columns: 1fr;
            }

            .gallery img {
                height: 250px;
            }
        }
    </style>
</head>

